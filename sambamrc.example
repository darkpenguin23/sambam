# sambam configuration file
# Place this file at /etc/sambamrc, ~/.sambamrc, or ./.sambamrc
# CLI flags override these settings.

# Listen address (default: 0.0.0.0:445)
# Supports IP:port or @interface[:port], e.g. "@eth0:445"
listen = "0.0.0.0:445"
# Optional multi-listener variant:
# listen_addrs = ["@eth0:445", "10.23.22.13:445"]

# Allowlist clients (optional)
# allow = ["192.168.1.10", "192.168.2.0/24"]

# Read-only mode
readonly = false

# Show connections and file activity
verbose = true
# verbose_level = 2   # equivalent to -vv
# verbose_level = 3   # equivalent to -vvv

# Hide files starting with '.'
# hide_dotfiles = true

# Authentication (optional)
# username = "admin"
# password = "secret123"

# Auto-expire (optional, e.g. 30m, 1h, 2h30m)
# expire = "30m"

# Daemon mode settings
# pidfile = "/tmp/sambam.pid"
# logfile = "/var/log/sambam.log"

# Shares - map of share_name = "/path/to/folder"
[shares]
docs = "/tmp/docs"
pics = "/tmp/pics"
