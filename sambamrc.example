# sambam configuration file
# Place this file at /etc/sambamrc, ~/.sambamrc, or ./.sambamrc
# CLI flags override these settings.

# Listen address (single endpoint)
listen = "0.0.0.0:445"

# Listen addresses (multi-endpoint variant; use instead of listen)
# Supports IP:port or @interface[:port], e.g. "@eth0:445"
# listen_addrs = ["@eth0:445", "10.23.22.13:445"]

# Allowlist clients (IP or CIDR)
allow = ["10.23.0.0/16"]

# Advertise SMB share via mDNS (_smb._tcp) + WS-Discovery
advertise = true

# Global defaults
readonly = false
hide_dotfiles = false

# Verbosity (choose one style)
verbose = true
# verbose_level = 2
# verbose_level = 3

# Compatibility options (equivalent to verbose_level=3 when true)
debug = false
trace = false

# Runtime controls
expire = "1h"
pidfile = "/tmp/sambam.pid"
logfile = "/tmp/sambam.log"

# Users
[[users]]
name = "alice"
password = "secret1"
readonly = false

[[users]]
name = "bob"
password = "secret2"
readonly = true

# Shares
[shares.docs]
path = "/tmp/docs"
allow_users = ["alice", "bob"]
readonly = false

[shares.private]
path = "/tmp/private"
allow_users = ["alice"]
readonly = true

[shares.public]
path = "/tmp/public"
guest = true
readonly = false
