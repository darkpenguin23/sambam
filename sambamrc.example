# sambam configuration file
# Place this file at /etc/sambamrc, ~/.sambamrc, or ./.sambamrc
# CLI flags override these settings.

[global]
# Listen endpoints (single string or array).
listen = "0.0.0.0:445"
# listen = ["@eth0:445", "10.23.22.13:445"]

# Allowlist clients (single IP/CIDR string or array).
allow = ["10.23.0.0/16"]

# Advertise SMB share via mDNS (_smb._tcp) + WS-Discovery
advertise = true
# SMB3 encryption is enabled by default (when client supports it).
# Set to false only for compatibility troubleshooting.
smb3_encryption = true
# Allow guest session setup for IPC$/browse discovery (macOS Finder compatibility),
# while share ACLs still enforce access.
# Set to false to disable guest browse fallback.
guest_browse_ipc = true
# Friendly discovery names shown to clients.
# mDNS (macOS Finder) default when omitted: "<hostname>-sambam"
# WSD (Windows Network) default when omitted: "<hostname>"
# discovery_name_mdns = "sambam-dev-sambam"
# discovery_name_wsd = "sambam-dev"

# Global defaults
readonly = false
hide_dotfiles = false

# Verbosity (choose one style)
verbose = true
# verbose_level = 2
# verbose_level = 3

# Compatibility options (equivalent to verbose_level=3 when true)
debug = false
trace = false

# Runtime controls
expire = "1h"
pidfile = "/tmp/sambam.pid"
logfile = "/tmp/sambam.log"

# Users
[user.alice]
password = "secret1"
readonly = false

[user.bob]
password = "secret2"
readonly = true

# Shares
[share.docs]
path = "/tmp/docs"
allow_users = ["alice", "bob"]
readonly = false

[share.private]
path = "/tmp/private"
allow_users = ["alice"]
readonly = true

[share.public]
path = "/tmp/public"
allow_users = ["guest"]
readonly = false
